# Copie para `.env` e ajuste. O `.env` esta no .gitignore e nao deve ser commitado.
#
#   cp .env.example .env
#
# NENHUM valor aqui e uma senha real. Gere a sua, por exemplo com:
#   openssl rand -base64 24

# --- banco ---
POSTGRES_DB=webgis
POSTGRES_USER=webgis
# Obrigatoria: o compose falha se ela nao estiver definida, de proposito.
POSTGRES_PASSWORD=troque-esta-senha

# --- aplicacao ---
# Porta em que o sistema fica disponivel no host.
WEBGIS_PORTA=8080

# INFO em uso normal; DEBUG para investigar.
WEBGIS_LOG_LEVEL=INFO

# Origens autorizadas por CORS, separadas por virgula. Vazio no compose porque
# o Nginx faz proxy de /api e tudo fica na mesma origem.
# Rodando sem Docker, com o dev-server do Angular: http://localhost:4200
WEBGIS_CORS_ORIGINS=

# --- pool de trabalho GIS ---
# Fila pequena de proposito: satura rapido e devolve 503, em vez de acumular
# trabalho ate faltar memoria.
WEBGIS_GIS_POOL_NUCLEO=2
WEBGIS_GIS_POOL_MAXIMO=4
WEBGIS_GIS_POOL_FILA=8
